[Unit]
Description=Parking Occupancy Tracker
After=network-online.target light-controller.service mosquitto.service
Wants=network-online.target
# receiver.type="mqtt" で broker(Mosquitto) を同一 Pi に同居運用する場合のみ有効化する。
# HTTP/GPIO 運用の Pi に mosquitto が無いと Requires で起動不能になるため既定はコメントアウト。
# Requires=mosquitto.service

[Service]
Type=simple
WorkingDirectory=/opt/parking
Environment=PYTHONPATH=/opt/parking/src
ExecStart=/opt/parking/.venv/bin/python -m parking /opt/parking/config.toml
Restart=on-failure
RestartSec=2s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
